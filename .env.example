# Application
APP_ENV=development
APP_HOST=localhost
API_PORT=8000

# Database
POSTGRES_DB=postgres
POSTGRES_USER=your-supabase-project-user
POSTGRES_PASSWORD=change-me-for-production
DATABASE_URL=postgresql://xpawsure:change-me-for-local-development@localhost:5432/xpawsure

# Authentication and encryption
JWT_SECRET=replace-with-a-long-random-local-secret
ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# External integrations
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
PAYMENT_PROVIDER_SECRET=
AI_PROVIDER_API_KEY=

# Email (optional — defaults to console backend for development)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=noreply@xpawsure.com
# EMAIL_HOST_PASSWORD=your-password

DEFAULT_FROM_EMAIL=noreply@xpawsure.com
SUPPORT_EMAIL=support@xpawsure.com

# Frontend
FRONTEND_URL=http://localhost:5173

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
