# Application
APP_ENV=development
APP_HOST=localhost
API_PORT=8000

# Django
# DEBUG must be False in production. When DEBUG=False the backend refuses to
# boot with the development SECRET_KEY or a wildcard ALLOWED_HOSTS.
DEBUG=True
# Generate a production value with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Local docker-compose defaults (see docker-compose.yml).
POSTGRES_DB=xpawsure
POSTGRES_USER=xpawsure
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql://xpawsure:change-me-for-local-development@localhost:5432/xpawsure
# Supabase: use the session-pooler URL and keep ?sslmode=require.
# Seconds to reuse a database connection. Keep 60 with one Render Free worker;
# use 0 if you switch to Supabase's transaction pooler (port 6543).
CONN_MAX_AGE=60

# CORS / CSRF
# Required when DEBUG=False: comma-separated frontend origins, including scheme.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081,http://localhost:8082
# Optional: only needed for session/CSRF-protected POSTs from another origin
# (for example, the Django admin behind a custom domain).
CSRF_TRUSTED_ORIGINS=
# Production-only HTTPS hardening. These values are enabled automatically when
# DEBUG=False; only override them if you have a specific reason.
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
FRONTEND_URL=http://localhost:5173

# Payments
# mock     – built-in signed checkout page in the web app (no keys required).
# paymongo – PayMongo hosted checkout; set the keys from Dashboard → Developers.
PAYMENT_MODE=mock
PAYMENT_CURRENCY=PHP
# How long a checkout stays payable before it expires.
PAYMENT_CHECKOUT_TTL_MINUTES=30
# Test mode: sk_test_...   Live mode: sk_live_...
PAYMONGO_SECRET_KEY=
# Webhook secret from Dashboard → Developers → Webhooks (whsec_...). Required
# when PAYMENT_MODE=paymongo and DEBUG=False.
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_API_URL=https://api.paymongo.com

# Supabase Storage
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
SUPABASE_STORAGE_BUCKET_PET_IMAGES=pet-images
SUPABASE_STORAGE_BUCKET_QR_CODES=qr-codes
SUPABASE_STORAGE_BUCKET_OWNER_IMAGES=owner-images
SUPABASE_STORAGE_BUCKET_CLINIC_IMAGES=clinic-images
SUPABASE_STORAGE_BUCKET_SCREENING_IMAGES=screening-images

# Claude Vision (backend-only second image review)
# The Django backend calls Anthropic; the mobile EfficientNet model stays
# entirely on-device. Never expose this key to a frontend or mobile bundle.
# Leave the key blank to keep screenings working with the on-device result only.
ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_API_VERSION=2023-06-01
# Configurable model ID; use a model available to your Anthropic account.
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=1500
ANTHROPIC_TIMEOUT_SECONDS=30

# Screening image and signed-result token limits.
SCREENING_IMAGE_MAX_BYTES=5242880
SCREENING_CLAUDE_TOKEN_MAX_AGE=3600
# Throttle rates for owner image-analysis and screening-creation requests.
VISION_ANALYSIS_THROTTLE_RATE=10/hour
SCREENING_CREATE_THROTTLE_RATE=30/hour

# Email — local development: Gmail SMTP
# Gmail requires a 16-character Google App Password (not your normal account
# password): myaccount.google.com → Security → 2-Step Verification → App
# passwords. See docs/engineering/DEPLOYMENT.md.
# Placeholders only — never commit real credentials.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-account@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
# Optional locally: defaults to EMAIL_HOST_USER.
DEFAULT_FROM_EMAIL=your-account@gmail.com
SUPPORT_EMAIL=your-account@gmail.com
# Maximum seconds a single delivery attempt may take.
EMAIL_TIMEOUT=10

# Email — production (Render Free): Brevo HTTPS API
# Render Free blocks outbound SMTP ports, so production switches the backend
# instead of changing any application code:
#   EMAIL_BACKEND=core.backends.brevo.BrevoEmailBackend
# Verify the address in DEFAULT_FROM_EMAIL as a sender in Brevo, then create an
# API key under Brevo → SMTP & API → API keys.
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
