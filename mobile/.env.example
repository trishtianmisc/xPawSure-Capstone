# Mobile (Expo) environment — copy to mobile/.env and adjust.

# Backend API base URL used by the app (EXPO_PUBLIC_* values are embedded
# at build time). Use your machine's LAN IP when testing on a device.
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Public web URL used to build pet-profile QR codes. When unset, the pet
# profile hides the QR code instead of rendering a dead localhost link.
EXPO_PUBLIC_WEB_URL=http://localhost:5173
